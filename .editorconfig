root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.ps1]
# Windows PowerShell 5.1 needs the BOM to read Chinese strings correctly.
charset = utf-8-bom

[*.{json,yml,yaml}]
indent_size = 2

[*.cmd]
end_of_line = crlf
